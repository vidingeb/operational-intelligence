#!/usr/bin/env bash
#
# spark-nim — bring a NIM microservice up/down on the DGX Spark (GB10)
# without starving the always-on Ollama assistant.
#
# The GB10 has ~128 GB of unified LPDDR5x shared by CPU and GPU, and no MIG,
# so nothing enforces isolation for us. This script is that enforcement:
# it refuses to start NIM unless there is enough free memory left over
# after the resident gpt-oss:120b (~65 GB, pinned with KEEP_ALIVE=-1).
#
# Usage:
#   ./scripts/spark-nim status     # what is running, what is free, when it expires
#   ./scripts/spark-nim up         # unpin assistant if needed, then start NIM
#   ./scripts/spark-nim down       # stop NIM, re-pin the assistant
#   ./scripts/spark-nim pin        # load the assistant model and hold it forever
#   ./scripts/spark-nim unpin      # evict the assistant model right now
#   ./scripts/spark-nim logs       # follow NIM logs
#
# Env:
#   REQUIRED_FREE_GB   headroom demanded before starting   (default 24)
#   ASSISTANT_MODEL    model to pin/unpin           (default gpt-oss:120b)
#   NIM_PORT           host port for the NIM               (default 8000)
#   READY_TIMEOUT      seconds to wait for readiness       (default 900)
#   AUTO_UNPIN=0       do not evict the assistant automatically on `up`
#   FORCE=1            skip the memory preflight

set -euo pipefail

REQUIRED_FREE_GB="${REQUIRED_FREE_GB:-24}"
ASSISTANT_MODEL="${ASSISTANT_MODEL:-gpt-oss:120b}"
NIM_PORT="${NIM_PORT:-8000}"
READY_TIMEOUT="${READY_TIMEOUT:-900}"
OLLAMA_URL="${OLLAMA_URL:-http://localhost:11434}"

cd "$(dirname "$0")/.."

log()  { printf '\033[0;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[0;33m[!]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[0;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }

compose() {
  if docker compose version >/dev/null 2>&1; then
    docker compose "$@"
  elif command -v docker-compose >/dev/null 2>&1; then
    docker-compose "$@"
  else
    die "neither 'docker compose' nor 'docker-compose' is available"
  fi
}

# Free memory in GB, plus the source we got it from.
#
# On GB10, `nvidia-smi --query-gpu=memory.used,memory.total` returns
# "[N/A], [N/A]" — the unified LPDDR5x pool is not exposed as discrete VRAM.
# So /proc/meminfo is the real signal here, not a fallback. Be aware that
# MemAvailable counts reclaimable page cache, so it can read optimistically:
# treat it as an upper bound, not a guarantee.
# Emits "<gb> <source>" on one line. Callers split it — assigning inside a
# command substitution would strand any variable set here in the subshell.
free_gb_raw() {
  local line used total
  if command -v nvidia-smi >/dev/null 2>&1; then
    line="$(nvidia-smi --query-gpu=memory.used,memory.total \
              --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ' || true)"
    used="${line%%,*}"
    total="${line##*,}"
    # Guard explicitly: GB10 answers "[N/A]", which is not a number.
    case "${used}${total}" in
      *[!0-9]*|"") ;;
      *)
        if [ "$total" -gt 0 ]; then
          echo "$(( (total - used) / 1024 )) nvidia-smi"
          return
        fi
        ;;
    esac
  fi
  if [ -r /proc/meminfo ]; then
    echo "$(awk '/MemAvailable/ {printf "%d", $2/1048576; exit}' /proc/meminfo) MemAvailable(incl-reclaimable-cache)"
    return
  fi
  echo "-1 unavailable"
}

free_gb()     { free_gb_raw | cut -d' ' -f1; }
free_source() { free_gb_raw | cut -d' ' -f2; }

have_python() { command -v python3 >/dev/null 2>&1; }

# Parse /api/ps robustly. Ollama emits compact JSON today, but a grep that
# assumes zero whitespace around ':' is a trap waiting to spring.
ollama_ps() {
  local body
  body="$(curl -sf --max-time 5 "${OLLAMA_URL}/api/ps" 2>/dev/null || true)"
  [ -n "$body" ] || return 0
  if have_python; then
    printf '%s' "$body" | python3 -c '
import json, sys
try:
    models = json.load(sys.stdin).get("models") or []
except Exception:
    sys.exit(0)
for m in models:
    size = m.get("size") or 0
    print("%s\t%.1f GB\texpires %s" % (
        m.get("name", "?"), size / 1024**3, m.get("expires_at", "?")))
'
  else
    printf '%s' "$body" |
      grep -o '"name"[[:space:]]*:[[:space:]]*"[^"]*"' |
      sed 's/.*"\([^"]*\)"$/\1/'
  fi
}

resident_models() { ollama_ps; }

# Ollama honours a per-request keep_alive that overrides OLLAMA_KEEP_ALIVE.
# A request with no prompt just loads or evicts, producing no tokens.
#   keep_alive: -1  -> resident forever
#   keep_alive:  0  -> evict as soon as this request returns
set_keep_alive() {
  local model="$1" ka="$2"
  curl -sf --max-time 600 "${OLLAMA_URL}/api/generate" \
    -H 'Content-Type: application/json' \
    -d "{\"model\":\"${model}\",\"keep_alive\":${ka}}" >/dev/null
}

cmd_pin() {
  local start elapsed
  log "Loading ${ASSISTANT_MODEL} and pinning it (keep_alive=-1)..."
  log "Cold load reads the whole model off NVMe — this is the slow first question."
  start="$(date +%s)"
  set_keep_alive "$ASSISTANT_MODEL" "-1" ||
    die "failed to pin ${ASSISTANT_MODEL}. Is NIM still holding memory? Try: $0 down"
  elapsed=$(( $(date +%s) - start ))
  log "Pinned in ${elapsed}s. That is your real reload cost — budget for it."
  cmd_status
}

cmd_unpin() {
  local start elapsed
  log "Evicting ${ASSISTANT_MODEL} (keep_alive=0)..."
  start="$(date +%s)"
  set_keep_alive "$ASSISTANT_MODEL" "0" ||
    warn "eviction request failed; model may not have been loaded"
  elapsed=$(( $(date +%s) - start ))
  sleep 2
  log "Evicted in ${elapsed}s."
  cmd_status
}

cmd_status() {
  local avail models
  avail="$(free_gb)"
  log "Memory available: ${avail} GB (threshold ${REQUIRED_FREE_GB} GB)"
  log "  source: $(free_source)"

  models="$(resident_models)"
  if [ -n "$models" ]; then
    log "Ollama resident:"
    printf '      %s\n' "$models"
  else
    log "Ollama: no model resident (memory free for NIM)"
  fi

  if curl -sf --max-time 5 "http://localhost:${NIM_PORT}/v1/health/ready" >/dev/null 2>&1; then
    log "NIM: ready on port ${NIM_PORT}"
  else
    log "NIM: not running"
  fi
}

cmd_up() {
  local avail waited

  # The compose file cannot enforce this itself: Compose interpolates the
  # whole file before filtering by profile, so a ${NGC_API_KEY:?...} guard
  # there would break the default profile too. Check it here instead, before
  # a pull that would otherwise fail on auth minutes later.
  if [ -z "${NGC_API_KEY:-}" ]; then
    warn "NGC_API_KEY is not set — the pull from nvcr.io will fail."
    warn "Get a key at https://ngc.nvidia.com, then:"
    warn "  echo \"\$NGC_API_KEY\" | docker login nvcr.io -u '\$oauthtoken' --password-stdin"
    # An already-cached image, or a prior `docker login`, can make this work
    # without the variable set — so allow the same override used elsewhere.
    [ "${FORCE:-0}" = "1" ] ||
      die "refusing to start NIM without a key. Re-run with FORCE=1 if you have already run 'docker login nvcr.io'."
    warn "FORCE=1 set — continuing without NGC_API_KEY."
  fi

  avail="$(free_gb)"

  # Not enough room? The assistant model is almost certainly the reason.
  # Evict it, then re-measure.
  if [ "$avail" -ge 0 ] && [ "$avail" -lt "$REQUIRED_FREE_GB" ] &&
     [ "${AUTO_UNPIN:-1}" = "1" ] && [ -n "$(resident_models)" ]; then
    warn "only ${avail} GB free — evicting ${ASSISTANT_MODEL} to make room"
    cmd_unpin
    avail="$(free_gb)"
  fi

  if [ "$avail" -lt 0 ]; then
    warn "could not determine free memory; proceeding blind"
  elif [ "$avail" -lt "$REQUIRED_FREE_GB" ]; then
    warn "still only ${avail} GB free, need ${REQUIRED_FREE_GB} GB."
    warn "Something other than ${ASSISTANT_MODEL} is holding memory."
    [ "${FORCE:-0}" = "1" ] || die "refusing to start NIM. Re-run with FORCE=1 to override."
    warn "FORCE=1 set — starting anyway. Expect contention."
  else
    log "Memory OK: ${avail} GB free"
  fi

  log "Starting NIM profile..."
  compose --profile nim up -d nim

  log "Waiting for readiness (up to ${READY_TIMEOUT}s; first run builds a TRT engine)..."
  waited=0
  while [ "$waited" -lt "$READY_TIMEOUT" ]; do
    if curl -sf --max-time 5 "http://localhost:${NIM_PORT}/v1/health/ready" >/dev/null 2>&1; then
      log "NIM ready -> http://localhost:${NIM_PORT}/v1"
      curl -sf --max-time 5 "http://localhost:${NIM_PORT}/v1/models" 2>/dev/null |
        grep -o '"id":"[^"]*"' | cut -d'"' -f4 | sed 's/^/      model: /' || true
      cmd_status
      return 0
    fi
    if [ -z "$(compose --profile nim ps -q nim 2>/dev/null)" ]; then
      die "NIM container exited. Check: ./scripts/spark-nim logs"
    fi
    sleep 10
    waited=$((waited + 10))
    if [ $((waited % 60)) -eq 0 ]; then
      log "  still waiting... ${waited}s"
    fi
  done

  die "NIM did not become ready in ${READY_TIMEOUT}s. Check: ./scripts/spark-nim logs"
}

cmd_down() {
  log "Stopping NIM profile..."
  compose --profile nim stop nim || true
  compose --profile nim rm -f nim || true
  log "NIM stopped, memory released."
  if [ "${AUTO_UNPIN:-1}" = "1" ]; then
    log "Restoring the assistant..."
    cmd_pin
  else
    cmd_status
  fi
}

cmd_logs() { compose --profile nim logs -f nim; }

case "${1:-status}" in
  up)     cmd_up ;;
  down)   cmd_down ;;
  pin)    cmd_pin ;;
  unpin)  cmd_unpin ;;
  status) cmd_status ;;
  logs)   cmd_logs ;;
  *)      die "usage: $0 {up|down|pin|unpin|status|logs}" ;;
esac
